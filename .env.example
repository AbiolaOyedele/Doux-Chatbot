# Server
PORT=3000

# Google Chat — space ID only (e.g. "AAA1234" from the space URL)
DEDICATED_SPACE_ID=your-google-chat-space-id

# Full service-account JSON as a single-line string
GOOGLE_CHAT_CREDENTIALS={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"...@....iam.gserviceaccount.com","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token"}

# Supabase — service role key for storage uploads
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Path to the assets directory (fonts + template images)
# Run scripts/copy-assets.sh to populate from flyer-gen/public
ASSETS_DIR=./assets

# Pub/Sub JWT audience — set to your deployed webhook URL
PUBSUB_AUDIENCE=https://your-bot.railway.app/webhook

# Optional: URL of an external render service (leave unset to render locally)
FLYER_TOOL_BACKEND_URL=
